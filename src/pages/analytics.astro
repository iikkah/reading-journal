---
import { analyticsDataset, analyticsFilterOptions } from '../data/analytics';

const analyticsJson = JSON.stringify({ dataset: analyticsDataset }).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Explore reading activity and ratings in the Reading Journal." />
		<title>Analytics · Reading Journal</title>
	</head>
	<body>
		<div id="analytics-data" data-payload={analyticsJson} hidden></div>
		<main class="page-shell">
			<header class="site-header">
				<a class="wordmark" href="/">Lukupäiväkirja</a>
				<nav aria-label="Main navigation">
					<a href="/books/">Kirjat</a>
					<a href="/">Etusivu</a>
				</nav>
			</header>

			<section class="intro" aria-labelledby="page-title">
				<p class="eyebrow">Lukupäiväkirja · tiedot</p>
				<h1 id="page-title">Lukemisen <em>analytiikkaa</em></h1>
				<p class="intro-copy">Näe kirjojen, lukukertojen ja arvostelujen jakaumat. Valitse suodattimia tai klikkaa pylvästä rajataksesi näkymää.</p>
			</section>

			<section class="filter-panel" aria-labelledby="filters-title">
				<div class="filter-heading">
					<div>
						<p class="eyebrow">Rajaa näkymää</p>
						<h2 id="filters-title">Suodattimet</h2>
					</div>
					<button id="clear-filters" class="clear-button" type="button">Tyhjennä suodattimet</button>
				</div>
				<div class="filter-grid">
					<label for="filter-year">Valmistumisvuosi
						<select id="filter-year"><option value="">Kaikki vuodet</option>{analyticsFilterOptions.years.map((year) => <option value={year}>{year}</option>)}</select>
					</label>
					<label for="filter-language">Kieli
						<select id="filter-language"><option value="">Kaikki kielet</option>{analyticsFilterOptions.languages.map((language) => <option value={language}>{language}</option>)}</select>
					</label>
					<label for="filter-format">Formaatti
						<select id="filter-format"><option value="">Kaikki formaatit</option>{analyticsFilterOptions.formats.map((format) => <option value={format}>{format}</option>)}</select>
					</label>
					<label for="filter-author">Kirjailija
						<select id="filter-author"><option value="">Kaikki kirjailijat</option>{analyticsFilterOptions.authors.map((author) => <option value={author}>{author}</option>)}</select>
					</label>
					<label for="filter-rating">Arvosana
						<select id="filter-rating"><option value="">Kaikki arvosanat</option>{analyticsFilterOptions.ratings.map((rating) => <option value={rating}>{rating}/5</option>)}</select>
					</label>
				</div>
				<p class="filter-note">Vuosisuodatin huomioi vain valmistumisvuodet; päivämäärättömät lukukerrat eivät kuulu vuosikaavioon.</p>
			</section>

			<section class="kpi-grid" aria-label="Reading key performance indicators">
				<article class="kpi-card"><p>Kirjoja valinnassa</p><strong id="kpi-books">—</strong><small>Yksittäisiä kirjoja katalogista</small></article>
				<article class="kpi-card"><p>Valmiita lukukertoja</p><strong id="kpi-completed">—</strong><small>Jokainen lukukerta lasketaan erikseen</small></article>
				<article class="kpi-card"><p>Kesken</p><strong id="kpi-reading">—</strong><small>Yksittäisiä kirjoja, joilla aktiivinen lukukerta</small></article>
				<article class="kpi-card"><p>Keskiarvo</p><strong id="kpi-rating">—</strong><small>Kirjakohtaisten arvosanojen keskiarvo</small></article>
			</section>

			<section class="chart-grid" aria-label="Reading charts">
				<article class="chart-panel">
					<div class="chart-heading"><div><p class="eyebrow">Ajan myötä</p><h2>Valmiit lukukerrat</h2></div><span>lukukertoja / vuosi</span></div>
					<div class="chart-frame"><canvas id="chart-year" role="img" aria-label="Valmiit lukukerrat valmistumisvuoden mukaan"></canvas><p id="empty-year" class="chart-empty" hidden>Ei valmistumispäivällisiä lukukertoja valituilla suodattimilla.</p></div>
				</article>
				<article class="chart-panel">
					<div class="chart-heading"><div><p class="eyebrow">Arvostelut</p><h2>Arvosanojen jakauma</h2></div><span>kirjoja / arvosana</span></div>
					<div class="chart-frame"><canvas id="chart-ratings" role="img" aria-label="Kirjojen määrä arvosanoittain yhdestä viiteen"></canvas><p id="empty-ratings" class="chart-empty" hidden>Ei arvosanoja valituilla suodattimilla.</p></div>
				</article>
				<article class="chart-panel">
					<div class="chart-heading"><div><p class="eyebrow">Kokoelma</p><h2>Kirjat kielen mukaan</h2></div><span>yksittäisiä kirjoja</span></div>
					<div class="chart-frame"><canvas id="chart-language" role="img" aria-label="Kirjojen määrä kielittäin"></canvas><p id="empty-language" class="chart-empty" hidden>Ei kirjoja valituilla suodattimilla.</p></div>
				</article>
				<article class="chart-panel">
					<div class="chart-heading"><div><p class="eyebrow">Kokoelma</p><h2>Kirjat formaatin mukaan</h2></div><span>yksittäisiä kirjoja</span></div>
					<div class="chart-frame"><canvas id="chart-format" role="img" aria-label="Kirjojen määrä formaateittain"></canvas><p id="empty-format" class="chart-empty" hidden>Ei kirjoja valituilla suodattimilla.</p></div>
				</article>
				<article class="chart-panel chart-panel-wide">
					<div class="chart-heading"><div><p class="eyebrow">Lukukerrat</p><h2>Useimmin luetut kirjailijat</h2></div><span>valmiita lukukertoja</span></div>
					<div class="chart-frame chart-frame-authors"><canvas id="chart-authors" role="img" aria-label="Kymmenen eniten luettua kirjailijaa valmiiden lukukertojen perusteella"></canvas><p id="empty-authors" class="chart-empty" hidden>Ei valmiita lukukertoja valituilla suodattimilla.</p></div>
				</article>
			</section>

			<footer class="site-footer">
				<p>Iikka Huttu</p>
				<a href="/books/">Palaa kirjoihin <span aria-hidden="true">→</span></a>
			</footer>
		</main>
	</body>
</html>

<script src="../scripts/analytics.ts"></script>

<style>
	:global(*) { box-sizing: border-box; }
	:global(html) {
		background: #f5f3ec;
		color: #262c25;
		font-family: Georgia, 'Times New Roman', serif;
		font-synthesis: none;
		text-rendering: optimizeLegibility;
		-webkit-font-smoothing: antialiased;
	}
	:global(body) { margin: 0; min-width: 320px; }
	.page-shell { width: min(100% - 3rem, 1180px); margin-inline: auto; }
	.site-header, .site-footer { display: flex; align-items: center; justify-content: space-between; }
	.site-header { min-height: 88px; border-bottom: 1px solid #d9ded3; }
	.wordmark { color: #263c30; font-size: 1.05rem; font-weight: 700; letter-spacing: -0.03em; text-decoration: none; }
	.site-header nav { display: flex; gap: 1.5rem; }
	.site-header nav a, .site-footer a { color: #47634d; font-family: Arial, sans-serif; font-size: 0.82rem; font-weight: 600; text-underline-offset: 4px; }
	.intro { max-width: 760px; padding: clamp(3.5rem, 7vw, 5.5rem) 0 3rem; }
	.eyebrow { margin: 0 0 0.75rem; color: #58705a; font-family: Arial, sans-serif; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; }
	h1 { margin: 0; font-size: clamp(2.6rem, 6vw, 5rem); font-weight: 400; letter-spacing: -0.06em; line-height: 1; }
	h1 em { color: #567258; font-weight: 400; }
	.intro-copy { max-width: 640px; margin: 1.2rem 0 0; color: #62665e; font-size: 1.05rem; line-height: 1.7; }
	.filter-panel { padding: 1.5rem; border: 1px solid #d9ded3; background: rgb(255 255 255 / 32%); }
	.filter-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
	.filter-heading h2 { margin: 0; font-size: 1.55rem; font-weight: 400; letter-spacing: -0.03em; }
	.filter-heading .eyebrow { margin-bottom: 0.35rem; }
	.clear-button { padding: 0.65rem 0.85rem; border: 1px solid #aeb9a9; background: transparent; color: #36533d; font: 600 0.8rem Arial, sans-serif; cursor: pointer; }
	.clear-button:hover { background: #e9ede5; }
	.filter-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.8rem; margin-top: 1.3rem; }
	.filter-grid label { display: grid; gap: 0.4rem; color: #62665e; font: 600 0.72rem Arial, sans-serif; }
	.filter-grid select { width: 100%; min-width: 0; padding: 0.7rem 0.55rem; border: 1px solid #d0d6cc; border-radius: 0; background: #fbfaf6; color: #262c25; font: 0.82rem Arial, sans-serif; }
	.filter-note { margin: 1rem 0 0; color: #77796f; font: 0.75rem/1.5 Arial, sans-serif; }
	.kpi-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.9rem; margin: 1rem 0; }
	.kpi-card { min-height: 130px; padding: 1.1rem 1.2rem; border: 1px solid #d9ded3; background: rgb(255 255 255 / 32%); }
	.kpi-card p { margin: 0 0 0.65rem; color: #62665e; font: 600 0.78rem Arial, sans-serif; }
	.kpi-card strong { display: block; color: #263c30; font-size: 2.15rem; font-weight: 400; letter-spacing: -0.05em; }
	.kpi-card small { display: block; margin-top: 0.4rem; color: #77796f; font: 0.68rem/1.4 Arial, sans-serif; }
	.chart-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.9rem; margin-bottom: 3.5rem; }
	.chart-panel { min-width: 0; padding: 1.25rem; border: 1px solid #d9ded3; background: rgb(255 255 255 / 32%); }
	.chart-panel-wide { grid-column: 1 / -1; }
	.chart-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; min-height: 48px; margin-bottom: 1rem; }
	.chart-heading h2 { margin: 0; font-size: 1.35rem; font-weight: 400; letter-spacing: -0.035em; }
	.chart-heading span { color: #77796f; font: 0.68rem Arial, sans-serif; text-align: right; }
	.chart-heading .eyebrow { margin-bottom: 0.35rem; }
	.chart-frame { position: relative; height: 260px; }
	.chart-frame-authors { height: 350px; }
	.chart-frame canvas { cursor: pointer; }
	.chart-empty { padding: 3.5rem 1rem; color: #74776f; font-size: 0.95rem; line-height: 1.5; text-align: center; }
	.site-footer { min-height: 76px; gap: 1rem; border-top: 1px solid #d9ded3; color: #77796f; font: 0.78rem Arial, sans-serif; }
	.site-footer p { margin: 0; }
	[hidden] { display: none !important; }
	@media (max-width: 850px) {
		.filter-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
		.kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
	@media (max-width: 620px) {
		.page-shell { width: min(100% - 2rem, 520px); }
		.site-header { min-height: 72px; }
		.site-header nav { gap: 0.9rem; }
		.filter-panel { padding: 1rem; }
		.filter-heading { align-items: flex-start; }
		.filter-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.chart-grid { grid-template-columns: 1fr; }
		.chart-panel-wide { grid-column: auto; }
		.chart-heading { align-items: flex-start; }
		.chart-frame { height: 230px; }
		.chart-frame-authors { height: 340px; }
	}
	@media (max-width: 400px) {
		.filter-heading { flex-direction: column; }
		.kpi-grid { grid-template-columns: 1fr 1fr; gap: 0.6rem; }
		.kpi-card { padding: 0.9rem; }
		.kpi-card strong { font-size: 1.8rem; }
		.site-header nav { gap: 0.65rem; }
	}
</style>
