---
import { books, readingEvents } from '../data/reading-data';
import { getRatingForBook } from '../data/reviews';
import { withBase } from '../utils/urls';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import { productionTheme } from '../config/theme';



const booksById = new Map(books.map((book) => [book.book_id, book]));
const recentlyRead = readingEvents
	.filter((event) => event.status === 'read')
	.map((event, index) => ({ event, index }))
	.sort((a, b) => {
		if (a.event.finished_on && b.event.finished_on) {
			return b.event.finished_on.localeCompare(a.event.finished_on);
		}
		if (a.event.finished_on) return -1;
		if (b.event.finished_on) return 1;
		// Without dates, use the CSV's order, with later rows treated as more recent.
		return b.index - a.index;
	})
	.slice(0, 3)
	.map(({ event }) => booksById.get(event.book_id)!);
import '../styles/site.css';
import '../styles/home.css';

---

<!doctype html>
<html lang="en" data-theme={productionTheme}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
		<link rel="icon" href={withBase('favicon.ico')} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="A personal record of books read and remembered." />
		<title>Reading Journal</title>
	</head>
	
	<body>
		<main class="page-shell">
			<header class="site-header">
				<a class="wordmark" href={withBase('')} aria-label="Reading Journal home">Lukupäiväkirja</a>
				<ThemeSwitcher />
			</header>
			<section class="intro" aria-labelledby="page-title">
				<p class="eyebrow">Ennen kaikkea omaksi ilokseni</p>
				<h1 id="page-title">Kirjallisuutta ja <em>horinaa.</em></h1>
				<p class="intro-copy">
					Minun henkilökohtainen lukupäiväkirjani, jossa pidän lukua lukemistani kirjoista sekä pieniä havaintoja tai arvosteluja silloin kun sellaisia jaksan kirjoitella.
				</p>
			</section>

			<section class="recent" aria-labelledby="recent-title">
				<div class="section-heading">
					<p class="eyebrow">Tuoreimmat</p>
					<h2 id="recent-title">Viimeisimpänä luetut</h2>
				</div>
				<ol class="book-list">
					
					{recentlyRead.map((book, index) => (
						<li class="book-card">
							<span class="book-number" aria-hidden="true">0{index + 1}</span>
							<div>
								<h3><a href={withBase(`books/${book.book_id}/`)}>{book.title}</a></h3>
								<p>{book.author}</p>
								{getRatingForBook(book.book_id) !== undefined && <span class="book-rating" aria-label={`Rating: ${getRatingForBook(book.book_id)} out of 5`}> Arvosana: {getRatingForBook(book.book_id)}/5</span>}
							</div>
							
							
							<span class="book-mark" aria-hidden="true">✳</span>
						</li>
					))}
				</ol>
				{recentlyRead.length === 0 && (
					<p class="empty-state">Your recently finished books will appear here once you add them to the reading list.</p>
				)}
			</section>

			<footer class="site-footer">
				<p>Iikka Huttu</p>
				<a href={withBase('books/')}>Kaikki kirjat <span aria-hidden="true">→</span></a>
			</footer>
		</main>
	</body>
</html>
