---
import { books, readingEvents } from '../data/reading-data';
import { getRatingForBook } from '../data/reviews';
import { withBase } from '../utils/urls';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';

const latestEventByBook = new Map<string, (typeof readingEvents)[number]>();
for (const event of readingEvents) {
	const current = latestEventByBook.get(event.book_id);
	const eventDate = event.finished_on || event.started_on;
	const currentDate = current?.finished_on || current?.started_on || '';
	if (!current || eventDate > currentDate || (!eventDate && !currentDate)) {
		latestEventByBook.set(event.book_id, event);
	}
}

const catalogue = [...books].sort((a, b) => {
	const aEvent = latestEventByBook.get(a.book_id);
	const bEvent = latestEventByBook.get(b.book_id);
	const aDate = aEvent?.finished_on || aEvent?.started_on || '';
	const bDate = bEvent?.finished_on || bEvent?.started_on || '';
	if (aDate && bDate) return bDate.localeCompare(aDate);
	if (aDate) return -1;
	if (bDate) return 1;
	return a.title.localeCompare(b.title);
});

const currentlyReading = catalogue.filter(
	(book) => latestEventByBook.get(book.book_id)?.status === 'reading',
);
const readBooks = catalogue.filter(
	(book) => latestEventByBook.get(book.book_id)?.status === 'read',
);
import '../styles/site.css';
import '../styles/books.css';

---

<!doctype html>
<html lang="en" data-theme="editorial">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
		<link rel="icon" href={withBase('favicon.ico')} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Books in my personal reading journal." />
		<title>Kirjat · Eräänlainen päiväkirja</title>
	</head>
	<body>
		<main class="page-shell">
			<header class="site-header">
				<a class="wordmark" href={withBase('')}>Lukupäiväkirja</a>
				<nav class="header-actions" aria-label="Page controls">
					<a class="back-link" href={withBase('')}>Takaisin etusivulle <span aria-hidden="true">←</span></a>
					<ThemeSwitcher />
				</nav>
			</header>

			<section class="intro" aria-labelledby="page-title">
				<p class="eyebrow">Iikan virtuaalikirjahylly</p>
				<h1 id="page-title">Kaikki kirjat</h1>
				<p class="intro-copy">Lukemani kirjat vuodesta 2026 alkaen listattuna. Oletusjärjestys uusimmasta luetusta vanhimpaan.</p>
			</section>

			<section class="book-section" aria-labelledby="currently-reading-title">
				<div class="section-heading">
					<h2 id="currently-reading-title">Tällä hetkellä työn alla</h2>
					<span>{currentlyReading.length}</span>
				</div>
				{currentlyReading.length > 0 ? (
					<ol class="book-list">
						{currentlyReading.map((book, index) => {
							const latestEvent = latestEventByBook.get(book.book_id);
							const date = latestEvent?.finished_on || latestEvent?.started_on;
							const rating = getRatingForBook(book.book_id);
							return (
								<li class="book-row">
									<span class="book-number" aria-hidden="true">{String(index + 1)}</span>
									<div class="book-details">
										<h2><a href={withBase(`books/${book.book_id}/`)}>{book.title}</a></h2>
										<p>
											{book.author}
											{rating !== undefined && <span class="book-rating" aria-label={`Rating: ${rating} out of 5`}> · {rating}/5</span>}
										</p>
									</div>
									{date && <time datetime={date}>Aloitettu {date}</time>}
								</li>
							);
						})}
					</ol>
				) : (
					<p class="empty-state">No books in progress right now. Add a reading event with status <code>reading</code> to show a book here.</p>
				)}
			</section>

			<section class="book-section" aria-labelledby="read-books-title">
				<div class="section-heading">
					<h2 id="read-books-title">Luetut kirjat</h2>
					<span>{readBooks.length}</span>
				</div>
				{readBooks.length > 0 ? (
					<ol class="book-list">
						{readBooks.map((book, index) => {
							const latestEvent = latestEventByBook.get(book.book_id);
							const date = latestEvent?.finished_on || latestEvent?.started_on;
							const rating = getRatingForBook(book.book_id);
							return (
								<li class="book-row">
									<span class="book-number" aria-hidden="true">{String(index + 1)}</span>
									<div class="book-details">
										<h2><a href={withBase(`books/${book.book_id}/`)}>{book.title}</a></h2>
										<p>
											{book.author}
											{rating !== undefined && <span class="book-rating" aria-label={`Rating: ${rating} out of 5`}> · {rating}/5</span>}
										</p>
									</div>
									{date && <time datetime={date}>Luettu {date}</time>}
								</li>
							);
						})}
					</ol>
				) : (
					<p class="empty-state">No finished books to show yet. Mark a completed reading event as <code>read</code> in reading_events.csv.</p>
				)}
			</section>

			<footer class="site-footer">
				<p>Iikka Huttu</p>
				<a href={withBase('')}>Takaisin etusivulle <span aria-hidden="true">→</span></a>
			</footer>
		</main>
	</body>
</html>
