---
import type { Book } from '../../data/reading-data';
import { books, readingEvents } from '../../data/reading-data';
import { getReviewForBook } from '../../data/reviews';
import { withBase } from '../../utils/urls';
import ThemeSwitcher from '../../components/ThemeSwitcher.astro';
import { productionTheme } from '../../config/theme';

export function getStaticPaths() {
	return books.map((book) => ({
		params: { book_id: book.book_id },
		props: { book },
	}));
}

const { book } = Astro.props as { book: Book };
const review = getReviewForBook(book.book_id);
const ReviewContent = review?.Content;
const rating = review?.rating;

const history = readingEvents
	.filter((event) => event.book_id === book.book_id)
	.map((event, index) => ({ event, index }))
	.sort((a, b) => {
		const aDate = a.event.finished_on || a.event.started_on;
		const bDate = b.event.finished_on || b.event.started_on;
		if (aDate && bDate) return bDate.localeCompare(aDate);
		if (aDate) return -1;
		if (bDate) return 1;
		return b.index - a.index;
	})
	.map(({ event }) => event);

const metadataLabels: Record<string, string> = {
	publication_year: 'Julkaisuvuosi',
	isbn: 'ISBN',
	format: 'Formaatti',
	notes: 'Muistiinpanot',
	language: 'Kieli',
};

const metadata = Object.entries(book)
	.filter(([field, value]) => !['book_id', 'title', 'author'].includes(field) && value !== undefined && value !== '')
	.map(([key, value]) => ({
		key,
		label: metadataLabels[key] ?? key.replaceAll('_', ' ').replace(/\b\w/g, (letter) => letter.toUpperCase()),
		value: String(value),
	}));

const statusLabels = {
	read: 'Luettu',
	reading: 'Kesken',
	abandoned: 'Lopetettu',
};

const languageTranslation: Record<string, string> = {
  English: 'englanti',
  Finnish: 'suomi',
};

const bookformat: Record<string, string> = {
  Ebook: 'E-kirja',
  Physical: 'Fyysinen kirja',
  Audiobook: 'Äänikirja',
};

import '../../styles/site.css';
import '../../styles/book-detail.css';

---



<!doctype html>
<html lang="en" data-theme={productionTheme}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
		<link rel="icon" href={withBase('favicon.ico')} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={`${book.title} by ${book.author} in the Reading Journal.`} />
		<title>{book.title} · Reading Journal</title>
	</head>
	<body>
		<main class="page-shell">
			<header class="site-header">
				<a class="wordmark" href={withBase('')}>Lukupäiväkirja</a>
				<nav class="header-actions" aria-label="Page controls">
					<a class="back-link" href={withBase('books/')}>← Takaisin kaikkiin kirjoihin</a>
					<ThemeSwitcher />
				</nav>
			</header>

			<article>
				<section class="intro" aria-labelledby="page-title">
					<p class="eyebrow">Kirja numero {book.book_id}</p>
					<h1 id="page-title">{book.title}</h1>
					<p class="author">{book.author}</p>
				</section>

				{metadata.length > 0 && (
					<section class="details-section" aria-labelledby="details-title">
						
						<h2 id="details-title">Kirjan tiedot</h2>
						<dl class="metadata-list">
							{metadata.map((item) => {
  							let value = item.value;

							if (item.key === 'language') {
    						value = languageTranslation[value] ?? value;
  							}

							if (item.key === 'format') {
    						value = bookformat[value] ?? value;
  							}
  							return (
    						<div class="metadata-row">
								<dt>{item.label}</dt>
      						<dd>{value}</dd>
    					</div>
  					);
				})}
						</dl>
					</section>
				)}
				<section class="history-section" aria-labelledby="history-title">
					<h2 id="history-title">Lukuhistoria</h2>
					{history.length > 0 ? (
						<ol class="history-list">
							{history.map((event, index) => (
								<li class="history-row">
									<span class="event-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
									<div class="event-details">
										<h3>{statusLabels[event.status]}</h3>
										<div class="event-dates">
											{event.started_on && <p>Aloitettu <time datetime={event.started_on}>{event.started_on}</time></p>}
											{event.finished_on && <p>Luettu <time datetime={event.finished_on}>{event.finished_on}</time></p>}
											{!event.started_on && !event.finished_on && <p>No dates recorded</p>}
										</div>
									</div>
								</li>
							))}
						</ol>
					) : (
						<p class="empty-state">There are no reading events recorded for this book yet.</p>
					)}
				</section>

				{ReviewContent && (
					<section class="review-section" aria-labelledby="review-title">
						<h2 id="review-title">Arvostelu</h2>
						{rating !== undefined && (
							<p class="review-rating">Arvosana <strong>{rating}/5</strong></p>
						)}
						<div class="review-content">
							<ReviewContent />
						</div>
					</section>
				)}
			</article>

			<footer class="site-footer">
				<p>Iikka Huttu</p>
				<a href={withBase('books/')}>Palaa kaikkiin kirjoihin <span aria-hidden="true">→</span></a>
			</footer>
		</main>
	</body>
</html>
